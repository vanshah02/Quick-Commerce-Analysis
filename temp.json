P BY item\n        ORDER BY total_quantity DESC\n        LIMIT 10", "top_items_freq": "SELECT item, COUNT(DISTINCT order_id) as order_frequency\n        FROM dataset\n        WHERE 1=1  AND item IS NOT NULL\n        GROUP BY item\n        ORDER BY order_frequency DESC\n        LIMIT 10", "top_items_profit": "SELECT \n            item, \n            SUM(line_profit) AS profit, \n            ROUND(SUM(line_profit) * 100.0 / SUM(line_revenue), 1) AS margin_pct\n        FROM dataset\n        WHERE 1=1  AND item IS NOT NULL\n        GROUP BY item\n        ORDER BY profit DESC\n        LIMIT 10", "best_combos": "SELECT \n            a.item AS item_a, \n            b.item AS item_b, \n            COUNT(*) AS times_together \n        FROM dataset a \n        JOIN dataset b \n            ON a.order_id = b.order_id \n            AND a.item < b.item \n        WHERE 1=1 \n        GROUP BY a.item, b.item \n        ORDER BY times_together DESC \n        LIMIT 10"}, "available_widgets": ["kpis", "group_contribution", "time_series", "top_items_qty", "top_items_freq", "top_items_profit", "best_combos"]}
